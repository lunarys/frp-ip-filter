# Copy to .env and adjust. Commented-out values show the defaults.
# See the Configuration section in README.md for details.

## Credentials

# Tokens valid for /unlock, comma-separated. Additional ones can be given as
# IP_TOKEN_1, IP_TOKEN_2, ... - all sources are combined.
IP_TOKENS=change-me
# IP_TOKEN_1=

# user:pass pairs valid for /dyndns, comma-separated. Additional ones can be
# given as DYNDNS_LOGIN_1, DYNDNS_LOGIN_2, ... - all sources are combined.
DYNDNS_LOGINS=
# DYNDNS_LOGIN_1=

## Listeners

# Inside the container, keep these in sync with the ports in docker-compose.yml.
# PUBLIC_ADDR=:8080
# PRIVATE_ADDR=:9090

# TLS for the public listener. Set both or neither; paths are as seen by the
# process (in the container, e.g. /certs/... via the volume in docker-compose.yml).
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem

## Allowlist

# Default outside the container is allowlist.json in the working directory;
# the Docker image sets /data/allowlist.json (on the data volume).
# ALLOWLIST_PATH=/data/allowlist.json
# ALLOWLIST_MAX_IPS=50
# ALLOWLIST_IP_TTL=24h
# ALLOWLIST_PREFIX_TTL=24h

## Logging

# ACCESS_LOG=true
# FRP_DEBUG=false
